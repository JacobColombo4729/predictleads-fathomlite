#!/bin/sh
# Eve: before each push to a personal branch, Claude tidies and reviews the commits going up
# (instructions in .claude/agents/eve.md). Turn on once per clone: git config core.hooksPath .githooks
# Skip it for one push: EVE_SKIP=1 git push

[ -n "$EVE_SKIP" ] && exit 0

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
range=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue        # deleting a branch
  [ "$remote_ref" = "refs/heads/main" ] && continue  # main only gets merges of work already reviewed
  [ "$local_sha" = "$head" ] || continue        # Eve edits the checked-out branch only
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || continue
  else
    base=$remote_sha
  fi
  range="$base..$local_sha"
done
[ -z "$range" ] && exit 0

# Commits up to Eve's last tidy commit are already reviewed: start after it
last_eve=$(git log -E --format=%H --grep='^(Keel|Eve): ' -n 1 "$range")  # Keel was Eve's earlier name
[ -n "$last_eve" ] && range="$last_eve..${range#*..}"
[ -z "$(git rev-list "$range")" ] && exit 0

if ! command -v claude >/dev/null 2>&1; then
  echo "Eve: Claude Code isn't installed, so this push goes up unreviewed."
  exit 0
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "Eve: commit or stash your uncommitted changes first, so Eve's tidy commit stays separate."
  echo "      (EVE_SKIP=1 git push skips Eve.)"
  exit 1
fi

# Eve's whole reach: read files, git, and (in the conversation) Claude's question boxes
tools='Read,Glob,Grep,Edit,Write,AskUserQuestion,Agent,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git status:*),Bash(git add:*),Bash(git rm:*),Bash(git mv:*),Bash(git commit:*),Bash(git config user.name)'

# Eve's review gets a session ID of its own, so the conversation below reopens that session and
# never someone's other Claude conversation in this folder
h=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
session="$(echo "$h" | cut -c1-8)-$(echo "$h" | cut -c9-12)-4$(echo "$h" | cut -c14-16)-a$(echo "$h" | cut -c18-20)-$(echo "$h" | cut -c21-32)"

# Size the push (notebooks and lock files left out) to decide how many helpers read it in parallel;
# thresholds from the repo's history: 90% of commits are under 400 lines and need none
stat=$(git diff --shortstat "$range" -- . ':!*.ipynb' ':!*lock.json' ':!*.lock')
files=$(echo "$stat" | awk '{print $1+0}')
lines=$(echo "$stat" | awk '{n=0; for (i=1; i<NF; i++) if ($(i+1) ~ /^(insertion|deletion)/) n+=$i; print n}')
if [ "$lines" -le 400 ] && [ "$files" -le 10 ]; then helpers=0
elif [ "$lines" -le 1500 ] && [ "$files" -le 25 ]; then helpers=2
elif [ "$lines" -le 5000 ] && [ "$files" -le 60 ]; then helpers=3
else helpers=5
fi

branch=$(git rev-parse --abbrev-ref HEAD)
gitdir=$(git rev-parse --git-dir)
report="$gitdir/eve-last-review.md"
echo "Eve: reviewing $(git rev-list --count "$range") commit(s) on $branch ($files files, $lines lines; $helpers helpers)..."
start=$(date +%s)
claude -p "Review and tidy the commits in $range on branch $branch, following your instructions. This push changes $files files and $lines lines: use $helpers eve-reader helpers." \
  --session-id "$session" --agent eve --permission-mode acceptEdits --allowedTools "$tools" < /dev/null | tee "$report"
# Timings, to tune the thresholds above from real runs
echo "$(date +%F) files=$files lines=$lines helpers=$helpers seconds=$(( $(date +%s) - start ))" >> "$gitdir/eve-timings.log"

# At a terminal (not VS Code's push button or a script), reopen that session so Eve can ask her
# questions with Claude's normal question boxes; the push carries on once you type /exit
if (: < /dev/tty) 2>/dev/null; then  # subshell: a failed redirect would end the hook
  case "$(git config user.name)" in Jacob*) other=Jesse ;; *) other=Jacob ;; esac
  echo
  echo "Eve: opening the conversation for your answers. Type /exit when she's done."
  claude --resume "$session" "Ask me your questions now, following 'Asking your questions' in your instructions. The other person is $other." \
    --agent eve --permission-mode acceptEdits --allowedTools "$tools" < /dev/tty > /dev/tty 2>&1
fi

# Never stop the push: Eve's own commit stays local and goes up with the next push
if [ "$(git rev-parse HEAD)" != "$head" ]; then
  echo
  echo "Eve tidied in a commit of its own; it goes up with your next push."
fi
exit 0
