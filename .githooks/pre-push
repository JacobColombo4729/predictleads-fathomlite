#!/bin/sh
# Eve: before each push to a personal branch, Claude tidies and reviews the commits going up
# (instructions in .claude/agents/eve.md). Turn on once per clone: git config core.hooksPath .githooks
# Skip it for one push: EVE_SKIP=1 git push

[ -n "$EVE_SKIP" ] && exit 0

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
range=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue        # deleting a branch
  [ "$remote_ref" = "refs/heads/main" ] && continue  # main only gets merges of work already reviewed
  [ "$local_sha" = "$head" ] || continue        # Eve edits the checked-out branch only
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || continue
  else
    base=$remote_sha
  fi
  range="$base..$local_sha"
done
[ -z "$range" ] && exit 0

# Commits up to Eve's last tidy commit are already reviewed: start after it
last_eve=$(git log -E --format=%H --grep='^(Keel|Eve): ' -n 1 "$range")  # Keel was Eve's earlier name
[ -n "$last_eve" ] && range="$last_eve..${range#*..}"
[ -z "$(git rev-list "$range")" ] && exit 0

if ! command -v claude >/dev/null 2>&1; then
  echo "Eve: Claude Code isn't installed, so this push goes up unreviewed."
  exit 0
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "Eve: commit or stash your uncommitted changes first, so Eve's tidy commit stays separate."
  echo "      (EVE_SKIP=1 git push skips Eve.)"
  exit 1
fi

# Runs Eve with the given prompt; the tool list is Eve's whole reach (read files, git only)
eve() {
  claude -p "$1" --agent eve --permission-mode acceptEdits \
    --allowedTools "Read" "Glob" "Grep" "Edit" "Write" \
      "Bash(git diff:*)" "Bash(git log:*)" "Bash(git show:*)" "Bash(git status:*)" \
      "Bash(git add:*)" "Bash(git rm:*)" "Bash(git mv:*)" "Bash(git commit:*)" "Bash(git config user.name)" \
    < /dev/null
}

branch=$(git rev-parse --abbrev-ref HEAD)
report="$(git rev-parse --git-dir)/eve-last-review.md"
echo "Eve: reviewing $(git rev-list --count "$range") commit(s) on $branch..."
eve "Review and tidy the commits in $range on branch $branch, following your instructions." | tee "$report"

# The rest needs someone at a terminal (not VS Code's push button or a script)
if (: < /dev/tty) 2>/dev/null; then  # subshell: a failed redirect would end the hook
  # Up to three rounds: Eve applies each round's answers and asks follow-ups only when they open something up
  history=$(cat "$report")
  round=1
  while [ $round -le 3 ] && grep -q '^ *a) ' "$report"; do
    echo
    printf "Your answers (e.g. 1a 2c 3 keep it), or Enter to skip: "
    read -r answers < /dev/tty
    [ -z "$answers" ] && break
    history="$history

Round $round answers: $answers"
    eve "These are the person's answers to round $round of your questions (rounds end after 3). Everything so far:
$history" | tee "$report"
    history="$history

$(cat "$report")"
    round=$((round + 1))
  done

  # The open question: what the pusher wants the other person to make sure of (kept in .claude/ASKS.md)
  case "$(git config user.name)" in Jacob*) other=Jesse ;; *) other=Jacob ;; esac
  echo
  printf "Anything you want %s to make sure he does? (Enter to skip): " "$other"
  read -r ask < /dev/tty
  [ -n "$ask" ] && eve "Record this ask from $(git config user.name) for $other in .claude/ASKS.md: $ask"
fi

# Never stop the push: Eve's own commit stays local and goes up with the next push
if [ "$(git rev-parse HEAD)" != "$head" ]; then
  echo
  echo "Eve tidied in a commit of its own; it goes up with your next push."
fi
exit 0
