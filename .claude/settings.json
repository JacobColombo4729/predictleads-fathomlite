{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./data/**)",
      "Read(./**/data/**)",
      "Read(./pretrained/**)",
      "Read(./models/**)",
      "Read(./**/*.json.zst)",
      "Read(./**/*.jsonl)",
      "Read(./**/*.csv)",
      "Read(./**/*.parquet)",
      "Read(./**/*.xlsx)",
      "Read(./**/*.pkl)",
      "Read(./**/*.joblib)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.sqlite3)",
      "Read(./**/*.db)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob|WebSearch|WebFetch|Artifact|SendUserFile|PushNotification|RemoteTrigger|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/safety/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
